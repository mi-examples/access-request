# Copy to `.env`. Never commit `.env` — it is gitignored.

# The MI instance the dev server proxies to.
MI_BACKEND_URL=https://beta7.metricinsights.com

# The App's `portal_page_id`, from the URL of its editor page in MI.
# Required by `npm run dev` and `npm run build`; the built bundle never reads it.
# Create the App first — see docs/MI-SETUP.md §1.
MI_APP_ID=

# Personal Access Token. Only used by `pp-dev sync`, never bundled.
MI_ACCESS_TOKEN=
